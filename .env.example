# Kopieer naar .env.local (lokaal) of stel in als Environment Variables op Vercel.

# Publieke URL van de site (zonder slash aan het eind)
NEXT_PUBLIC_SITE_URL=https://www.uwtvmonteur.nl

# VERPLICHT voor livegang: SMTP-gegevens waarmee het afspraakformulier wordt
# verstuurd (app/api/afspraak/route.ts). Zonder deze gegevens opent het
# formulier alleen een e-mailconcept en komen aanvragen NIET vanzelf binnen.
SMTP_HOST=smtp.voorbeeld.nl
SMTP_PORT=587
SMTP_USER=info@uwtvmonteur.nl
SMTP_PASS=
# "true" bij poort 465 (impliciete TLS); bij 587 (STARTTLS) leeg laten
SMTP_SECURE=
# Waar de aanvragen naartoe gaan (standaard: e-mailadres uit lib/site.ts)
MAIL_TO=
# Afzenderadres (standaard: SMTP_USER; moet meestal gelijk zijn aan het SMTP-account)
MAIL_FROM=

# Conversiemeting (optioneel, maar nodig om Google Ads te kunnen sturen op afspraken)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_CONVERSION_FORM=
NEXT_PUBLIC_ADS_CONVERSION_CALL=
